---
const audiences = [
  { name: 'Customers', description: 'Find nearby shops and compare prices.', status: 'In device testing', href: '#shoppers', role: 'customer', icon: 'M6 8h12l1 12H5L6 8Zm3 0V6a3 3 0 0 1 6 0v2' },
  { name: 'Merchants', description: 'Explore sales, stock, orders and credit.', status: 'In device testing', href: '#merchants', role: 'merchant', icon: 'M3 10h18l-2-6H5l-2 6Zm2 0v10h14V10M9 20v-7h6v7' },
  { name: 'Riders', description: 'Follow shop-managed delivery.', status: 'In device testing', href: '#delivery', icon: 'm12 3 9 5v9l-9 5-9-5V8l9-5Zm0 9 9-4M12 12 3 8m9 4v10M7.5 5.5l9 5v5' },
  { name: 'Diaspora', description: 'Explore essentials for family in Ethiopia.', status: 'Planned · not available', href: '#diaspora', icon: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z' },
];
---
<details id="explore-dropdown" class="explore-dropdown">
  <summary class="explore-toggle" aria-controls="explore-options">
    Explore ZAYA
    <svg class="explore-chevron" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg>
  </summary>
  <div id="explore-options" class="explore-options">
    <ul class="explore-audiences" aria-label="Choose your ZAYA experience">
      {audiences.map((audience, index) => <li>
        <a href={audience.href} data-explore-audience={index} data-feature-role={'role' in audience ? audience.role : undefined} data-feature-screen={'role' in audience ? '0' : undefined}>
          <span class="explore-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d={audience.icon}/></svg></span>
          <span class="explore-copy"><strong>{audience.name}<span class="explore-arrow" aria-hidden="true"> →</span></strong><span class="explore-description">{audience.description}</span><span class:list={['explore-status', { 'explore-planned': index === 3 }]}>{audience.status}</span></span>
        </a>
      </li>)}
    </ul>
  </div>
</details>
<script>import '../scripts/explore-menu.ts';</script>
<style>
  .explore-dropdown { position: static; flex-shrink: 0; }
  .explore-toggle { min-height: 48px; padding: 10px 14px; gap: 8px; border: 1px solid var(--teal-ink); border-radius: var(--radius-control); color: var(--teal-ink); font-size: 14px; line-height: 1.5; font-weight: 600; white-space: nowrap; }
  .explore-chevron { transition: transform .18s ease-out; }
  .explore-dropdown[open] .explore-toggle { background: var(--mint); }
  .explore-dropdown[open] .explore-chevron { transform: rotate(180deg); }
  .explore-options { position: absolute; top: 100%; inset-inline: 0; padding: 16px 0; background: var(--cloud); border-top: 1px solid var(--line); }
  .explore-audiences { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 0; padding: 0; list-style: none; }
  .explore-audiences li { min-width: 0; }
  .explore-audiences a { display: flex; align-items: flex-start; gap: 14px; height: 100%; min-height: 100px; padding: 14px; border: 1px solid var(--line); border-radius: var(--radius-control); background: var(--surface); }
  .explore-audiences a:focus-visible { outline-offset: -3px; }
  .explore-icon { display: flex; flex: 0 0 42px; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: var(--radius-control); background: var(--mint); color: var(--teal-ink); }
  .explore-copy { display: flex; min-width: 0; flex-direction: column; gap: 3px; }
  .explore-copy strong { font-size: 16px; line-height: 1.4; font-weight: 600; }
  .explore-arrow { color: var(--teal-ink); }
  .explore-description { color: var(--muted); font-size: 14px; line-height: 1.5; }
  .explore-status { color: var(--teal-ink); font-size: 12px; line-height: 1.5; }
  .explore-planned { color: var(--muted); }
  @media (min-width: 901px) { .explore-audiences { grid-template-columns: repeat(4,minmax(0,1fr)); }.explore-audiences a { gap: 10px; padding: 12px; }.explore-icon { width: 36px; height: 36px; flex-basis: 36px; }.explore-copy strong { font-size: 15px; }.explore-description { font-size: 13px; } }
  @media (hover: hover) { .explore-toggle:hover, .explore-audiences a:hover { background: var(--mint); } .explore-audiences a:hover strong { text-decoration: underline; text-underline-offset: 4px; } }
  @media (max-width: 650px) {
    .explore-toggle { padding-inline: 10px; font-size: 13px; }
    .explore-options { padding-block: 12px; }
    .explore-audiences a { flex-direction: column; gap: 8px; padding: 12px; }
    .explore-icon { width: 36px; height: 36px; flex-basis: 36px; }
    .explore-icon svg { width: 23px; height: 23px; }
    .explore-copy strong { font-size: 14px; }
    .explore-description { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .explore-chevron { transition: none; } }
  :global(.reduce-motion) .explore-chevron { transition: none; }
  @media (forced-colors: active) { .explore-toggle, .explore-audiences a { border-color: ButtonText; } .explore-icon, .explore-arrow { color: LinkText; } }
</style>
