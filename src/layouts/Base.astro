---
import '../styles/typography.css';
import '../styles/tokens.css';
import '../styles/site.css';
import site from '../content/data/site.json';
import AssistantWidget from '../components/AssistantWidget.astro';
import { assistantState } from '../config/assistant-state.mjs';

interface Props { title?: string; description?: string; }
const {
  title = `${site.brandName} — ${site.tagline}`,
  description = "Ethiopia's local commerce, connected — helping neighbourhood shops sell and customers find what's in their area. Merchant pilot opening in Nifas Silk Lafto, Addis Ababa.",
} = Astro.props;

// F4 BINDING honesty gate: until real Privacy/Terms exist and site.published is
// flipped true, the whole site stays noindex. /robots.txt (src/pages/robots.txt.ts,
// which reads THIS SAME site.json) + scripts/check-publish.mjs enforce the same
// rule at build time — one switch, three consumers, no second source of truth.
const noindex = !site.published;

// SEPARATE SWITCH (founder ruling 2026-08-20). The assistant has its own gate in
// src/config/assistant.json + the ZAYA_ASSISTANT / ZAYA_ASSISTANT_TOKEN env pair.
// `site.published` is NOT an input to it and never will be: publishing the site
// must not expose the AI, and previewing the AI must not publish the site.
// When this resolves off, the widget is not rendered AT ALL — no markup, no CSS,
// no script, nothing to un-hide. See docs/ASSISTANT-GATE.md.
const assistant = assistantState();
// Config-driven canonical (Astro.site = $URL on Netlify, else zayaethiopia.com).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1E2A4A" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZAYA App" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="ZAYA App — Your neighbourhood, within reach." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Enable JS-gated entrance/scroll animations. If JS is off, this never runs
        and the full static page renders. If the interaction bundle LOADS but then
        errors/parse-fails, the reveal observer never arms 'zr-armed' — so after a
        short timeout we drop 'js' and un-hide everything: no content is ever
        trapped hidden. Runs before first paint (no flash of un-animated content). */}
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){var d=document.documentElement;if(!d.classList.contains('zr-armed'))d.classList.remove('js')},2500)</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {/* P1b-3 LANDMARKS. This used to be `<main id="main"><slot /></main>`, and
        the homepage's own <header> and <footer> went inside the slot — so the
        document had ONE landmark: a <main> wrapping everything, including the
        site header and the footer. A <header>/<footer> nested inside <main> is
        NOT a banner/contentinfo landmark (HTML-AAM scopes both to the body),
        so the page exposed zero banner and zero contentinfo, and "Skip to
        content" jumped to an element that STARTS ABOVE the header — it skipped
        nothing.
        The page chrome now goes in NAMED slots so it lands as a direct child of
        <body>, and <main> contains only the content between them. Pages with no
        chrome of their own (privacy, terms) fill the default slot and get the
        <main> alone, which is correct for them. */}
    <slot name="header" />
    <main id="main" tabindex="-1"><slot /></main>
    <slot name="footer" />
    {/* Website AI Assistant — founder-access preview (CR-027/ADR-024, FDR-019 W-D4a).
        MOUNTED ONLY WHEN ITS OWN GATE IS OPEN (never by site.published). Off by
        default: W-D4b (public launch) is the founder's gate and stays his.
        scripts/check-publish.mjs asserts this line is still conditional. */}
    {assistant.enabled && <AssistantWidget token={assistant.token} />}
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
