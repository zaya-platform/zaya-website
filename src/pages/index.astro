---
import '../styles/global.css';
import '../styles/features.css';
import '../styles/motion.css';
import '../styles/neighbourhood-page.css';

import Promo from '../components/Promo.astro';
import FeaturesMenu from '../components/FeaturesMenu.astro';
import ExploreMenu from '../components/ExploreMenu.astro';
import BrandMeaning from '../components/BrandMeaning.astro';
import SupportTriage from '../components/SupportTriage.astro';
import Neighbourhood from '../components/Neighbourhood.astro';
import social from '../data/social.json';
const roles = [
 {id:'customer',name:'For shoppers',num:'01',title:'Find what you need.\nCompare before you go.',text:'Browse shops in your chosen area and compare products and prices before deciding where to shop.',features:['Choose your area','Browse local shops','Compare products and prices'],image:'customer.png',alt:'ZAYA customer app showing the shop browsing screen with seeded demonstration data.'},
 {id:'merchant',name:'For merchants',num:'02',title:'Your shop’s daily work,\nin one place.',text:'Sales, stock, orders and customer credit in one place. Practical tools that give you more room to focus on the people across your counter.',features:['Record sales and track stock','Keep customer credit organised','Manage incoming orders'],image:'merchant.png',alt:'ZAYA merchant dashboard captured from the app with seeded demonstration sales data.'},
];
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <title>ZAYA — Everything near you.</title>
 <meta name="robots" content="noindex, follow" /><meta name="description" content="Meet ZAYA, the local commerce platform being built for Ethiopia’s neighbourhood shops and their customers. Explore the app, planned Diaspora experience and launch updates." />
 <meta name="theme-color" content="#F4F7F8" /><meta property="og:title" content="ZAYA — Everything near you." /><meta property="og:description" content="A closer connection to your neighbourhood. Discover the next chapter of local commerce in Ethiopia." /><meta property="og:type" content="website" /><meta property="og:image" content="https://zayaethiopia.netlify.app/images/addis-portrait.jpg" />
 <link rel="canonical" href="https://zayaethiopia.netlify.app/" />
 <meta property="og:url" content="https://zayaethiopia.netlify.app/" />
 <link rel="icon" type="image/svg+xml" href="/brand-icon.svg" />


<noscript><style is:inline>.tour-controls,.enlarge-screen,.delivery-controls,#motion-toggle,.brand-wave-mark{display:none}.brand-wave .official-brand{animation:none}.role-panel[hidden]{display:grid}.role-tabs{display:none}@media(max-width:900px){.nav nav{display:flex;position:static;flex-direction:row;flex-wrap:wrap;box-shadow:none;padding:8px 0}.nav{height:auto;flex-wrap:wrap;padding-block:10px}.menu-toggle{display:none}}.site-header .nav{flex-wrap:wrap}.site-header #explore-dropdown[open]{flex-basis:100%;order:5}.site-header #explore-dropdown .explore-options{position:static;max-height:none;overflow:visible}.site-header #explore-dropdown[open] .explore-toggle{width:max-content}</style></noscript>

</head>
<body>
 <a class="skip" href="#main">Skip to content</a>
 <header class="site-header">
  <div class="nav wrap"><a class="brand brand-wave" href="#top" aria-label="ZAYA home"><img class="official-brand" src="/brand-horizontal.svg" width="220" height="62" alt="ZAYA App — Everything near you." /><span class="brand-wave-mark" aria-hidden="true"></span></a>
   <ExploreMenu />
   <button class="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label="More navigation"><span class="menu-label">Menu</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
   <nav id="navigation" aria-label="Main navigation"><FeaturesMenu /><a href="#faq">FAQ</a><a class="button small" href="#contact">Enquire</a></nav>
  </div>
 </header>
 <main id="main">
 <section class="hero wrap" id="top">
  <div class="hero-copy">
   <h1>Everything<br />near <span class="word-you">you<svg viewBox="0 0 290 24" aria-hidden="true"><path d="M4 17Q137-3 280 12" /></svg></span>.</h1>
   <p class="intro">ZAYA is being built to help you discover neighbourhood shops and compare products and prices.</p>
  </div>
  <Neighbourhood />
  <div class="hero-details">
   <p class="hero-detail">For shop owners, it brings sales, stock, orders and customer credit together.</p>
   <div class="launch-note"><span class="dot" aria-hidden="true"></span><div><strong>In development · Addis Ababa, Ethiopia</strong><span>Public access and a launch date are not yet confirmed.</span></div></div>
   <div class="actions"><a class="button" href="#experience">Explore the app <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a><a class="text-link" href="#contact">Talk to the ZAYA team</a></div>
   <a class="hero-meaning text-link" href="#meaning">What does ZAYA stand for?</a>
  </div>
  <nav class="hero-ribbon" aria-label="Quick start">
   <a href="#experience"><span class="ribbon-index">01</span><span><strong>Explore nearby</strong><small>Browse local shops and products</small></span><span class="ribbon-arrow" aria-hidden="true">↗</span></a>
   <a href="#delivery"><span class="ribbon-index">02</span><span><strong>Follow an order</strong><small>See the shop-managed journey</small></span><span class="ribbon-arrow" aria-hidden="true">↗</span></a>
   <a href="#promo"><span class="ribbon-index">03</span><span><strong>Watch the story</strong><small>Meet the ZAYA vision on video</small></span><span class="ribbon-arrow" aria-hidden="true">↗</span></a>
  </nav>
 </section>
 <section class="section experience-section" id="experience"><div class="wrap">
  <div class="section-heading experience-heading"><div><h2>Made for your<br />side of the counter.</h2><p>Explore the tools being tested for shoppers and shop owners.</p></div><figure class="local-portrait"><img src="/images/addis-portrait-small.jpg" width="700" height="923" loading="lazy" alt="A young woman outdoors in Addis Ababa, photographed by Abiy Fikru." /><figcaption>Addis Ababa · Abiy Fikru / Pexels</figcaption></figure></div><span id="shoppers" class="audience-anchor"></span><span id="merchants" class="audience-anchor"></span>
  <div class="role-tabs" role="tablist" aria-label="Explore ZAYA experiences">{roles.map((role,i)=><button id={`tab-${role.id}`} role="tab" aria-controls={`panel-${role.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><span>{role.name}</span></button>)}</div>
  {roles.map((role,i)=><article class="role-panel" id={`panel-${role.id}`} role="tabpanel" aria-labelledby={`tab-${role.id}`} hidden={i!==0} tabindex="0"><div class="role-copy"><span class="status">In device testing</span><h3>{role.title.split('\n').map(line=><span>{line}<br /></span>)}</h3><p>{role.text}</p><ul class="feature-list">{role.features.map(feature=><li><span aria-hidden="true">✓</span>{feature}</li>)}</ul><div class="tour-controls" data-tour={role.id} aria-label={role.id==='customer'?'Customer app walkthrough':'Merchant app walkthrough'}><p class="tour-hint">EXPLORE THE APP SCREENS</p><div class="tour-buttons"><button data-screen="0" aria-pressed="true" aria-controls={'screen-'+role.id}>01 <span>{role.id==='customer'?'Browse shops':'Your dashboard'}</span></button><button data-screen="1" aria-pressed="false" aria-controls={'screen-'+role.id}>02 <span>{role.id==='customer'?'Compare prices':'Customer credit'}</span></button></div><p class="tour-description" aria-live="polite">{role.id==='customer'?'Start with the shops in your chosen area.':'See your shop’s daily activity in one place.'}</p></div><a class="text-link" href={role.id==='customer'?'mailto:zayaapp@gmail.com?subject=ZAYA%20shopper%20enquiry':'mailto:zayaapp@gmail.com?subject=ZAYA%20merchant%20pilot%20enquiry'}>{role.id==='customer'?'Email a shopper enquiry':'Email a merchant pilot enquiry'}</a><p class="action-note">Opens your email app.</p></div><div class="screen-scene"><div class="screen-orbit" aria-hidden="true"></div><div class="phone"><img id={`screen-${role.id}`} src={`/images/${role.image}`} width="432" height="960" loading="lazy" alt={role.alt}/></div><div class="screen-label"><div><span class="dot"></span> Actual app screen<br /><small>Seeded demo data · August 2026</small></div><button class="enlarge-screen" data-enlarge={role.id} aria-label={`Enlarge ${role.id} app screen`} aria-haspopup="dialog">View larger <span aria-hidden="true">↗</span></button></div></div></article>)}
 </div></section>
 <section class="section wrap connections" id="delivery"><div class="ride-visual" data-stage="0" aria-label="Illustrated delivery route between a shop and a home"><div class="route-grid" aria-hidden="true"></div><svg class="route-path" viewBox="0 0 500 380" aria-hidden="true"><path d="M95 265H195Q235 265 235 225V150Q235 115 270 115H390" /><circle cx="95" cy="265" r="8"/><circle cx="390" cy="115" r="8"/></svg><div class="place shop-place"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10h18l-2-6H5l-2 6Zm2 0v10h14V10M9 20v-7h6v7"/></svg><b>Neighbourhood shop</b></div><div class="place home-place"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8M5 10v11h14V10M9 21v-8h6v8"/></svg><b>At your door</b></div><div class="delivery-cube" aria-hidden="true"><svg viewBox="0 0 80 80"><path d="m40 8 28 15v33L40 72 12 56V23Z M12 23l28 16 28-16 M40 39v33 M26 16l28 16v13"/></svg></div><span class="visual-caption">Illustrated shop-managed delivery workflow</span></div><div class="connection-copy"><h2>Delivery,<br />managed by the shop.</h2><p>Commerce doesn’t end at the counter. ZAYA’s delivery workflow connects an order with the shop’s own deliverer and records how it is completed.</p><span class="status">Delivery workflow · in device testing</span><p class="delivery-distinction">This shop-managed workflow is separate from the planned RIDE experience.</p><div class="delivery-controls"><p class="tour-hint">EXPLORE THE DELIVERY JOURNEY</p><div class="delivery-buttons" role="group" aria-label="Delivery journey steps"><button data-delivery="0" aria-pressed="true">1. Prepare</button><button data-delivery="1" aria-pressed="false">2. Deliver</button><button data-delivery="2" aria-pressed="false">3. Complete</button></div><p class="delivery-description" aria-live="polite">The shop confirms the order and prepares it for collection.</p></div><a class="text-link" href="mailto:zayaapp@gmail.com?subject=ZAYA%20shop-managed%20delivery%20enquiry">Email a delivery enquiry</a><p class="action-note">Opens your email app.</p></div></section>
 <Promo />
 <BrandMeaning />
 <section class="next-section section" id="next"><div class="wrap">
  <div class="section-heading"><h2>What’s next</h2><p>These experiences are planned. They are not available today.</p></div>
  <div class="planned-grid">
   <article id="ride"><span class="status">Planned experience</span><h3>RIDE</h3><p>A future direction for ZAYA. The service details are still being defined.</p><p>Passenger rides and ride booking are not available. Shop-managed delivery is a separate workflow currently in device testing.</p><a class="text-link" href="mailto:zayaapp@gmail.com?subject=ZAYA%20RIDE%20enquiry">Email about RIDE</a></article>
   <article id="diaspora"><span class="status">Planned experience</span><h3>For the Diaspora</h3><p>A way to provide everyday essentials for family in Ethiopia through neighbourhood shops.</p><p>Diaspora ordering is not yet available. ZAYA is not a money-transfer service.</p><a class="text-link" href="mailto:zayaapp@gmail.com?subject=ZAYA%20Diaspora%20enquiry">Email about Diaspora</a></article>
  </div><p class="action-note">Enquiry links open your email app.</p>
 </div></section>
 <section class="section wrap faq-section" id="faq"><div><h2>Questions,<br />answered.</h2></div><div class="faqs"><details><summary>Can I use ZAYA today?<span aria-hidden="true">+</span></summary><p>ZAYA is in development. Merchant, customer and delivery tools are in device testing. Public access and a launch date have not been confirmed.</p></details><details><summary>Where is ZAYA starting?<span aria-hidden="true">+</span></summary><p>ZAYA is being developed in Addis Ababa, Ethiopia. Public service areas have not been confirmed. Email the team to ask about pilot participation.</p></details><details><summary>What does it cost?<span aria-hidden="true">+</span></summary><p>Pricing has not been confirmed for public launch. Contact the team for current information.</p></details><details><summary>What about languages and offline use?<span aria-hidden="true">+</span></summary><p>Local languages, low-data use and offline shop operations are central to ZAYA’s direction. Language coverage and offline behaviour still require launch validation. Voice and smart search remain planned.</p></details><details><summary>Is RIDE a ride-hailing service?<span aria-hidden="true">+</span></summary><p>RIDE is a roadmap item, not an available transport product. ZAYA’s current delivery workflow is managed by individual shops. Passenger rides and ride booking are not available; final RIDE details will be announced by the team.</p></details></div></section>
 <section class="contact-section" id="contact"><div class="wrap contact-inner"><h2>Start a conversation<br />with ZAYA.</h2><p>Ask about launch updates or tell us about your shop and your interest in the merchant pilot.</p><SupportTriage /><div class="actions"><a class="button" href="mailto:zayaapp@gmail.com?subject=ZAYA%20launch%20updates">Email for launch updates</a><a class="text-link" href="mailto:zayaapp@gmail.com?subject=ZAYA%20merchant%20pilot%20enquiry">Ask about the merchant pilot</a></div><p class="action-note">Email links open your email app. The website does not register or send an enquiry automatically.</p><div class="contact-direct"><a href="mailto:zayaapp@gmail.com">zayaapp@gmail.com</a><a href="tel:+251912835922">Call +251 91 283 5922</a></div></div></section>
 </main>
<dialog id="screen-dialog" aria-labelledby="screen-dialog-title"><div class="dialog-top"><h2 id="screen-dialog-title">Inside ZAYA</h2><button class="dialog-close" aria-label="Close enlarged screen">Close <span aria-hidden="true">×</span></button></div><p class="dialog-note">Actual app capture · seeded demo data</p><img id="dialog-screen" width="432" height="960" alt="" /><form method="dialog"><button class="button">Back to the experience</button></form></dialog>
 <footer class="wrap"><div class="footer-top"><a class="brand" href="#top" aria-label="ZAYA back to top"><img class="official-brand" src="/brand-horizontal.svg" width="220" height="62" alt="ZAYA App — Everything near you." /></a><p>Everything near you.</p><a href="#top" class="back-top">Back to top ↑</a></div><div class="footer-bottom"><span>© 2026 ZAYA · Addis Ababa, Ethiopia</span><div>{social.channelUrl && <a href={social.channelUrl} target="_blank" rel="noopener noreferrer" aria-label="ZAYA on YouTube (opens in a new tab)">YouTube ↗</a>}<a href="/privacy">Privacy</a><a href="/terms">Website terms</a><button id="motion-toggle" aria-pressed="true">Motion: on</button></div></div></footer>
 <script>import '../scripts/navigation.ts';</script>
</body>
</html>


