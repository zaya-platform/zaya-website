---
import Base from '../layouts/Base.astro';

// ── A3/A4, 2026-08-23 — THE INTERACTIVE DEMO + THE PERSONA PHOTOS ───────────
//
// THE SCREENS. The public page now shows REAL-APP CAPTURES: 9 screens x EN/AM,
// recorded 2026-08-23 from the running product (platform main @1b6114a) against
// an isolated seeded backend, icons and all. Full record in
// src/assets/demo/_provenance.json. The S9-T12 golden baselines stay in
// src/assets/screens/ as the repo's reference record, but they no longer render
// here — their harness artefacts (gallery pill row, missing icon glyphs) needed
// a page of QA explanation that has no business in front of a visitor, and the
// captures have neither artefact.
//
// UNRETOUCHED MEANS UNRETOUCHED, so two of the app's own wordings ship inside
// these pixels and are flagged rather than cropped: the customer browse screen
// prints the app's own section heading and quick-action wording for shops in
// the picked area, and the compare screen's info line says results match "by
// item name" across the area's shops using the app's own adjective. Both are
// the PLATFORM's copy (its QF4 wording domain), photographed, not this site's
// copy — this page's own words stay inside ratchets A-C, and the captions below
// never repeat a proximity claim. Cropping the pixels would be retouching;
// the flag lives here and in the phase report instead.
//
// SCREENS 4 and 8 of the old baselines stay excluded from the repo (they render
// distances the platform cannot compute — see ratchet G2), and nothing here
// re-captures those screens.
//
// THE PHOTOS (A4, founder ruling 2026-08-23). The truth pass deleted eight
// AI-generated photographs and RECORDED a standing option: they may return only
// with (1) a visible "Illustration" label in the rendered page and (2) the
// third-party-trademark question resolved per file. The founder has now ruled
// on both, and this pass implements the ruling for the PERSONA photos only:
//
//   credit-book.jpg      RESTORED (merchant pane) — pixel inspection found no
//                        readable third-party mark; byte-for-byte from history,
//                        nothing altered; labelled "Illustration" on-page.
//   diaspora-family.jpg  RESTORED (diaspora pane) — same inspection, same
//                        result, same label; nothing altered.
//   customer-app.jpg     LEFT OUT. Nestlé "NIDO" is legible on six-plus cans
//                        across half the frame — unremovable without wrecking
//                        the image — and its phone screen is the FABRICATED app
//                        interface the truth pass removed unconditionally. A
//                        missing photo is honest; this one stays missing.
//
// The other five (storefront, storefront-wide, counter-sale, supermarket,
// stock-check) are not persona photos and stay out. The full per-file record —
// inspections, what was and was not altered, and the left-out grounds — is
// src/assets/photos/_rights.json, and scripts/check-publish.mjs refuses a
// publish build while any shipped image lacks a resolved trademark record.
import creditBook from '../assets/photos/credit-book.jpg';
import diasporaFamily from '../assets/photos/diaspora-family.jpg';

import cBrowseEn from '../assets/demo/customer_browse_en.png';
import cBrowseAm from '../assets/demo/customer_browse_am.png';
import cCompareEn from '../assets/demo/customer_compare_en.png';
import cCompareAm from '../assets/demo/customer_compare_am.png';
import cShopEn from '../assets/demo/customer_shop_en.png';
import cShopAm from '../assets/demo/customer_shop_am.png';
import cCheckoutEn from '../assets/demo/customer_checkout_en.png';
import cCheckoutAm from '../assets/demo/customer_checkout_am.png';
import cTrackEn from '../assets/demo/customer_tracking_en.png';
import cTrackAm from '../assets/demo/customer_tracking_am.png';
import mDashEn from '../assets/demo/merchant_dashboard_en.png';
import mDashAm from '../assets/demo/merchant_dashboard_am.png';
import mSaleEn from '../assets/demo/merchant_sale_en.png';
import mSaleAm from '../assets/demo/merchant_sale_am.png';
import mInboxEn from '../assets/demo/merchant_inbox_en.png';
import mInboxAm from '../assets/demo/merchant_inbox_am.png';
import mCreditEn from '../assets/demo/merchant_credit_en.png';
import mCreditAm from '../assets/demo/merchant_credit_am.png';

// The tap-through flows. Captions are BENEFIT-LED and belong to this site, so
// they answer to ratchets A-C like every other sentence here: no proximity
// claim, ever, in any caption. Each step ships BOTH languages in the HTML; the
// CSS-only radio toggle above the explorer decides which one shows.
const DEMO = {
  merchant: [
    { k: 'dashboard', en: mDashEn, am: mDashAm,
      t: 'The whole day on one screen',
      c: 'Sales, products and today’s activity — counted for you as you work.',
      alt: 'Merchant app, Dashboard: shortcuts for Sale, Products, Orders and Credit, and a Today panel showing ETB 872.00 in sales from the seeded demo shop.' },
    { k: 'sale', en: mSaleEn, am: mSaleAm,
      t: 'Record a sale in two taps',
      c: 'Tap the item, tap Record — the total and your stock keep themselves right.',
      alt: 'Merchant app, Quick Sale: a tap-to-add grid of the shop’s items with prices in Birr, a running total of ETB 472.00 and a Record sale button.' },
    { k: 'orders', en: mInboxEn, am: mInboxAm,
      t: 'Never miss an order',
      c: 'New orders arrive with the items, the total and the delivery point — confirm or decline in one tap.',
      alt: 'Merchant app, Orders inbox: a new order for ETB 122.00 with its items, delivery landmark, masked customer phone, an auto-expiry countdown, and Decline and Confirm buttons.' },
    { k: 'credit', en: mCreditEn, am: mCreditAm,
      t: 'Every credit, written down',
      c: 'The digital credit book keeps each customer’s balance — ZAYA records credit; the shopkeeper decides.',
      alt: 'Merchant app, Credit book: customers with optional credit limits, an Add customer button, and the note that ZAYA records credit while the merchant decides — it never lends money or charges interest.' },
  ],
  customer: [
    { k: 'browse', en: cBrowseEn, am: cBrowseAm,
      t: 'Pick your area, see its shops',
      c: 'Real shops with real shelves — see what your area actually has before you go.',
      alt: 'Customer app, home: a search bar, quick actions for scanning and browsing, and a list of seeded demo shops in the picked area — two carry a Sponsored badge.' },
    { k: 'compare', en: cCompareEn, am: cCompareAm,
      t: 'Compare prices before you spend',
      c: 'One search shows who stocks an item and for how much — best price ranked first.',
      alt: 'Customer app, Compare prices: a search for sugar (ስኳር) ranked across the area’s seeded shops — Best price ETB 86.48, then #2 at 88.32 and #3 at 90.16 — with the app’s note that results match by item name and the shop confirms availability.' },
    { k: 'shop', en: cShopEn, am: cShopAm,
      t: 'Walk the shelves from home',
      c: 'Open a shop and see its items and prices in Birr, kept by the shop itself.',
      alt: 'Customer app, a single shop’s page: category chips and its item list with prices in Birr — bread, sugar, oil, onions — each with an add-to-cart button. The shop is the seeded demo shop.' },
    { k: 'order', en: cCheckoutEn, am: cCheckoutAm,
      t: 'Order in a few taps',
      c: 'Cash on delivery to the place you describe — you pay the shop when it arrives.',
      alt: 'Customer app, cart and checkout: two items totalling ETB 122.00, a landmark-based delivery address, contact phone, and a cash-on-delivery note above the Place order button.' },
    { k: 'track', en: cTrackEn, am: cTrackAm,
      t: 'See exactly where your order stands',
      c: 'From waiting to confirmed to delivered — and an unanswered order expires honestly.',
      alt: 'Customer app, My orders: the placed order marked Waiting for the shop, with the 30-minute auto-expiry explained, the items, the ETB 122.00 total and a Cancel order button.' },
  ],
};
// CMS-managed content (admin edits these JSON files via Decap /admin)
import pricing from '../content/data/pricing.json';
import contact from '../content/data/contact.json';
import faq from '../content/data/faq.json';
import { assistantState } from '../config/assistant-state.mjs';
const telHref = (p) => 'tel:' + p.replace(/\s/g, '');

// The assistant's OWN gate (founder ruling 2026-08-20) — the same resolver the
// layout uses, not a second flag. This page carries TWO assistant entry points
// besides the widget itself: the nav "Ask ZAYA AI" button and the whole
// "ask-band" section. Both are driven by `data-open-assistant`, whose click
// handler ships INSIDE the widget — so with the widget gated off they were dead
// controls and a promise the page could not keep. They are gated with it.
const assistant = assistantState();

// Hero hub-and-spoke — the ZAYA network as it actually stands. Six nodes only
// (fewer, truer): the three participants + three BUILT capabilities. No unbuilt
// vertical appears here. Positions are computed on an even ring so the canvas
// spokes (drawn client-side) always meet the SSR-rendered cards. Icons are
// ZAYA's own line set — never the reference graphic's icons or its non-brand
// palette.
//
// R4 (2026-08-23): the 'nearby' node is now 'area'. The product does area
// SELECTION — browse is anchored to an area the customer picks (a query param);
// the platform has NO shop lat/lng at all, so a proximity claim has nothing
// behind it. Its MAP-PIN icon went with the word: a dropped pin is a
// geolocation claim drawn instead of written.
const HUB = [
  { key: 'customers', label: 'Customers',      tone: 'teal',  a: -90,
    d: 'M9 11a3 3 0 100-6 3 3 0 000 6zM3.5 20a5.5 5.5 0 0111 0M16 5.4a3 3 0 010 5.2M20.5 20a5.5 5.5 0 00-3-4.9' },
  { key: 'area',      label: 'Shops in your area', tone: 'navy',  a: -30,
    d: 'M4 6h7v5H4zM13 6h7v5h-7zM4 13h7v5H4zM13 13h7v5h-7z' },
  { key: 'compare',   label: 'Compare prices', tone: 'coral', a: 30,
    d: 'M12 4v16M7 20h10M7 8h10M7 8l-3 5.2a3 3 0 006 0zM17 8l-3 5.2a3 3 0 006 0z' },
  { key: 'merchants', label: 'Merchants',      tone: 'teal',  a: 90,
    d: 'M6.2 8h11.6l-1 12H7.2l-1-12zM9 8V6.2a3 3 0 016 0V8' },
  { key: 'credit',    label: 'Credit book',    tone: 'navy',  a: 150,
    d: 'M12 6.4C10.4 5.4 7.8 5 5 5.6V19c2.8-.6 5.4-.2 7 .9 1.6-1.1 4.2-1.5 7-.9V5.6c-2.8-.6-5.4-.2-7 .8zM12 6.4V19.9' },
  { key: 'shops',     label: 'Shops',          tone: 'coral', a: 210,
    d: 'M4.5 9l1-4.2A1 1 0 016.5 4h11a1 1 0 011 .8L20 9M5.4 9v9.5a1 1 0 001 1h11.2a1 1 0 001-1V9M4.5 9h15' }
].map((n) => {
  const rad = (n.a * Math.PI) / 180, R = 35;
  return { ...n, xp: +(50 + R * Math.cos(rad)).toFixed(2), yp: +(50 + R * Math.sin(rad)).toFixed(2) };
});
---
<Base>
{/* P1b-3: the page chrome goes into Base's NAMED slots so it renders as a direct
    child of <body> and therefore actually EXPOSES a banner landmark. Inside the
    old <main> wrapper it exposed none. Same for the footer below. */}
<header class="site-header" slot="header">
  <div class="pilot-strip">
    <div class="wrap pilot-strip-in">
      <span><b>Merchant pilot opening</b> in Nifas Silk Lafto</span>
      <a href="#contact">Request early access <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
  <div class="wrap nav">
    <a class="lock" href="#top" aria-label="ZAYA App — Everything near you">
      <svg class="mk" viewBox="0 0 512 512" role="img" aria-hidden="true">
        <defs>
          <linearGradient id="zg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#13B7B4"/><stop offset="1" stop-color="#0B8B8A"/></linearGradient>
          <clipPath id="zc"><rect width="512" height="512" rx="115"/></clipPath>
        </defs>
        <g clip-path="url(#zc)"><rect width="512" height="512" fill="url(#zg)"/>
          <circle class="rr" cx="256" cy="200" r="288"/><circle class="rr rr2" cx="256" cy="200" r="288"/><circle class="rr rr3" cx="256" cy="200" r="288"/></g>
        <path d="M333.7 249.2 L256 372 L178.3 249.2 A92 92 0 1 1 333.7 249.2 Z" fill="#fff"/>
        <circle cx="256" cy="200" r="56" fill="#FF7A45"/>
        <polyline points="224,180 286,180 226,220 289,220" fill="none" stroke="#fff" stroke-width="17" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="txt">
        <span class="wm">ZAYA <b>App</b></span>
        <span class="tl">Everything near you.</span>
      </span>
    </a>
    <nav class="menu" id="primary-menu" aria-label="Primary">
      <div class="item"><a href="#top">Home</a></div>
      <div class="item">
        <a href="#solutions" aria-haspopup="true" aria-expanded="false">Features <svg class="ch" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
        <div class="drop" aria-label="ZAYA features">
          <a href="#solutions">Sales &amp; inventory <span class="st built">Built — in device testing</span></a>
          <a href="#solutions">The credit book <span class="st built">Built — in device testing</span></a>
          <a href="#solutions">Find &amp; compare shops <span class="st built">Built — in device testing</span></a>
          <a href="#solutions">Delivery &amp; COD settlement <span class="st built">Built — in device testing</span></a>
          <a href="#diaspora">The diaspora basket <span class="st planned">Planned</span></a>
        </div>
      </div>
      <div class="item">
        <a href="#experience" aria-haspopup="true" aria-expanded="false">For you <svg class="ch" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
        <div class="drop" aria-label="Choose your role">
          <a href="#experience" data-role-jump="merchant">Merchants <span class="st built">Built — in device testing</span></a>
          <a href="#experience" data-role-jump="customer">Customers <span class="st built">Built — in device testing</span></a>
          <a href="#experience" data-role-jump="diaspora">Diaspora <span class="st planned">Planned</span></a>
        </div>
      </div>
      <div class="item"><a href="#pricing">Pricing</a></div>
      <div class="item"><a href="#faq">FAQ</a></div>
      {assistant.enabled && <button class="menu-ai" type="button" data-open-assistant>Ask ZAYA AI</button>}
    </nav>
    <a class="btn btn-primary cta" href="#contact">Join the pilot</a>
    <button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="primary-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="hero" id="top">
  <div class="wrap hero-in">
    <div class="copy">
      <span class="eyebrow">Built in Ethiopia &middot; Made for every neighbourhood</span>
      <h1>Your neighbourhood, <span class="g">within reach.</span></h1>
      <p class="sub">ZAYA connects the shops in your area and their customers in one trusted local-commerce network &mdash; so every search and sale starts in your own neighbourhood.</p>
      <div class="who">
        <a class="chip" href="#experience" data-role-jump="merchant">For <b>merchants</b></a>
        <a class="chip" href="#experience" data-role-jump="customer">For <b>customers</b></a>
        <a class="chip" href="#experience" data-role-jump="diaspora">For the <b>diaspora</b></a>
      </div>
      <div class="hcta">
        <a class="btn btn-primary" href="#contact"><span>Join the pilot</span><svg class="ar" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a class="btn btn-ghost" href="#experience">See how it works</a>
      </div>
    </div>
    <div class="hero-visual" role="img" aria-label="The ZAYA network: a central hub linked to six parts — customers, merchants and shops, plus browsing the shops in a chosen area, comparing prices and the credit book.">
      <div class="hubwrap">
        <canvas id="eco" aria-hidden="true"></canvas>
        <div class="hub-core" aria-hidden="true">
          <svg class="hub-mark" viewBox="0 0 512 512" role="img" aria-hidden="true">
            <path d="M333.7 249.2 L256 372 L178.3 249.2 A92 92 0 1 1 333.7 249.2 Z" fill="#fff"/>
            <circle cx="256" cy="200" r="52" fill="#FF7A45"/>
            <polyline points="226,182 284,182 228,218 286,218" fill="none" stroke="#fff" stroke-width="17" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="hub-word">ZAYA</span>
        </div>
        {HUB.map((n) => (
          <span class={`hub-node hub-${n.tone}`} data-key={n.key} style={`left:${n.xp}%;top:${n.yp}%`}>
            <span class="hub-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={n.d}/></svg>
            </span>
            <span class="hub-name">{n.label}</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</div>

<div class="trust-rail" aria-label="ZAYA at a glance">
  <div class="wrap trust-rail-in">
    <div><span>Pilot area</span><b>Nifas Silk Lafto</b></div>
    <div><span>Merchant tools</span><b class="axis">Built — in device testing</b></div>
    <div><span>Customer browse &amp; order</span><b class="axis">Built — in device testing</b></div>
    <div><span>Delivery &amp; COD settlement</span><b class="axis">Built — in device testing</b></div>
  </div>
</div>

{/* ── THE NAME (founder request, 2026-08-23) ─────────────────────────────────
    Decision D-018 makes the brand identity — the backronym included — a binding
    architectural artifact, so the NAME and the four PILLAR NAMES below are
    quoted verbatim from docs/ZEPO/06_reference/ZAYA_Current_State_Summary_v3.0.md
    §6, as is the one-sentence summary in the lead. Nothing else here is.

    WHAT IS DELIBERATELY *NOT* COPIED, AND WHY. The brand book's pillar
    paragraphs describe a product that does not exist: GPS listing "within a
    configurable radius (default 5 km)", a map view, geo-filters (distance,
    rating, open-now), price comparison across twenty shops at once, expiry
    alerts, payment unification across Telebirr/M-Pesa, and voice-first
    interaction. Reproducing them here would put the exact over-claiming the
    NO-GO review condemned onto the most prominent part of the page, and the
    radius/20-shops language would walk straight through the R4 proximity ban
    that scripts/test-claims.mjs ratchets A and C now guard.
    So this section says WHAT THE NAME MEANS, not what the app does. Each
    letter's explanatory line is written for this site and describes intent;
    the capability claim is quarantined in the evidence line beneath it, where
    it carries the one labelling axis (R1) and names a specific built thing.

    NO JAVASCRIPT AT ALL. The reveal is four native radios plus :checked sibling
    selectors, so it behaves identically with JS on and off — there is no
    bundle to fail, nothing is injected, and every pillar is in the HTML. See
    the "THE NAME" block in site.css for the a11y measurements. */}
<section class="band-navy zmean" id="meaning">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">What the name means</span>
      <h2>ZAYA is an acronym. Every letter is a promise we can keep.</h2>
      <p>Zonal &middot; Availability &middot; Yours &middot; Access &mdash; your neighbourhood market, visible, yours, and open to everyone.</p>
    </div>

    <fieldset class="zmean-x">
      <legend>Choose a letter to read what it stands for</legend>

      <input class="zmean-radio" type="radio" name="zmean" id="zmean-z" checked />
      <input class="zmean-radio" type="radio" name="zmean" id="zmean-a1" />
      <input class="zmean-radio" type="radio" name="zmean" id="zmean-y" />
      <input class="zmean-radio" type="radio" name="zmean" id="zmean-a2" />

      <div class="zmean-letters">
        <label class="zmean-letter" for="zmean-z"><span class="zl">Z</span><span class="zn">Zonal</span></label>
        <label class="zmean-letter" for="zmean-a1"><span class="zl">A</span><span class="zn">Availability</span></label>
        <label class="zmean-letter" for="zmean-y"><span class="zl">Y</span><span class="zn">Yours</span></label>
        <label class="zmean-letter" for="zmean-a2"><span class="zl">A</span><span class="zn">Access</span></label>
      </div>

      <div class="zmean-stage" aria-live="polite">
        <article class="zmean-panel" data-zmean="z">
          <h3>Z &mdash; Zonal</h3>
          <p>You pick the area; ZAYA shows the shops in it. The zone is your choice, never a guess made for you.</p>
          <p class="zmean-ev"><span class="st built">Built — in device testing</span> <span>Choosing an area, and browsing the shops in it.</span></p>
        </article>
        <article class="zmean-panel" data-zmean="a1">
          <h3>A &mdash; Availability</h3>
          <p>Know before you go &mdash; real stock and real prices, straight from the shop&rsquo;s own book.</p>
          <p class="zmean-ev"><span class="st built">Built — in device testing</span> <span>Stock and prices kept in the shop&rsquo;s own book.</span></p>
        </article>
        <article class="zmean-panel" data-zmean="y">
          <h3>Y &mdash; Yours</h3>
          <p>Your shop, your book, your customers. The shopkeeper&rsquo;s call on credit and price comes before anything ZAYA suggests.</p>
          <p class="zmean-ev"><span class="st built">Built — in device testing</span> <span>The merchant cockpit and the digital credit ledger.</span></p>
        </article>
        <article class="zmean-panel" data-zmean="a2">
          <h3>A &mdash; Access</h3>
          <p>Nobody locked out &mdash; four languages, cash on delivery, and the low-end Android phones people actually own.</p>
          <p class="zmean-ev"><span class="st built">Built — in device testing</span> <span>Cash-on-delivery settlement; four languages rendering in the app.</span></p>
        </article>
      </div>
    </fieldset>

    <p class="zmean-note">This says what the name means &mdash; it is not a feature list. Everything ZAYA can actually do is labelled where it is claimed, further down this page.</p>
  </div>
</section>

<section class="band"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow" id="problems">The problem today</span>
    <h2>Everyday commerce runs on memory, paper, and guesswork.</h2>
  </div>
  <div class="pain-grid">
    <div class="pain">
      <h3><span class="d"></span>Customers</h3>
      <ul>
        <li>Hard to find the right shops in your own area.</li>
        <li>No way to know prices before you go.</li>
        <li>Long trips across Addis for small errands.</li>
        <li>Delivery is slow, informal, or unavailable.</li>
      </ul>
    </div>
    <div class="pain">
      <h3><span class="d"></span>Merchants</h3>
      <ul>
        <li>Stock counted by hand and by memory.</li>
        <li>Credit tracked on paper that gets lost.</li>
        <li>Little visibility into what actually sells.</li>
        <li>No presence online for new customers to find.</li>
      </ul>
    </div>
    <div class="pain">
      <h3><span class="d"></span>Diaspora</h3>
      <ul>
        <li>Hard to support family from far away.</li>
        <li>Money sent home, hoping it becomes what's needed.</li>
        <li>No visibility into whether goods arrived.</li>
        <li>No simple way to buy the exact items back home.</li>
      </ul>
    </div>
  </div>
</div></section>

<section class="solve">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow" id="solutions">How ZAYA helps</span>
      <h2>One platform that removes the everyday friction of local commerce.</h2>
      <p>Real tools for real problems — on one labelling axis: <b>Built — in device testing</b>, <b>In pilot</b>, <b>Live</b>, <b>Planned</b>. Nothing below is in pilot or live yet.</p>
    </div>
    <div class="cards">
      <div class="card"><div class="ic"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg></div><h3>Shops in your area <span class="st built">Built — in device testing</span></h3><p>Choose your area and see the shops in it, and who has what.</p></div>
      <div class="card"><div class="ic"><svg viewBox="0 0 24 24"><path d="M6 3v18M18 3v18M6 8h12M6 14h12"/></svg></div><h3>Compare fair prices <span class="st built">Built — in device testing</span></h3><p>Check prices across the shops in your area before you spend a single Birr.</p></div>
